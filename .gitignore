# Python & IDE caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.vscode/
.idea/
.codegraph/
*.log

# Local archive of legacy v1/QML experiments & scratch notes
archive/

# Large external/regenerable datasets (>25 MB; see data/README.md)
data/ligands_phytochemical/phytochemical_screening_set.csv
data/ligands_phytochemical/*.zip
data/features/*_training_features.csv

# Full 738k per-target raw screen dumps (~40 MB each; consensus shortlists are tracked)
results/predictions/*_screen_full.csv.gz

# The uncompressed shortlist. With tau non-binding on two of three targets the
# in-AD rule admits 94% of the library, so this file came out at 213 MB -- past
# GitHub's 100 MB hard limit. consensus_hits.csv.gz is tracked in its place and
# holds every row; step 05 rewrites the plain CSV on each run.
results/predictions/consensus_hits.csv

# Pipeline checkpoint is run-local state, not a result
pipeline_checkpoint.json

# Prepared receptors. Open Babel adds polar hydrogens at an arbitrary rotation,
# so two consecutive runs of the same command differ by a few HD atoms; a
# tracked copy is stale the moment step 06 runs and leaves the tree permanently
# dirty. Regenerated from *_clean_receptor.pdb, which is the real input.
data/targets/*.pdbqt

# Docked poses are regenerated by step 06 from the receptors and the ligand
# sets, so they are outputs, not inputs. Tracking them meant the repository
# shipped poses from a superseded protocol (fixed box, exhaustiveness 8,
# one seed) that the current code would never produce, which is the same
# staleness the report refuses to render. Regenerate with step 06.
results/docking_poses/

# Fitted model artifacts: a 300-tree forest over 2048 ECFP bits is 60-170 MB,
# past GitHub's file limit. Deterministic, so regenerate with step 04.
models/*_final.joblib
models/*_final.pkl
