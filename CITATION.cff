    given-names: Ishmam Rashid
    affiliation: BRAC University
repository-code: "https://github.com/thinkiamparanoid2/hcc-kinase-conformal-screen"
license: MIT
keywords:
  - conformal prediction
  - applicability domain
  - QSAR
  - virtual screening
  - natural products
  - kinase inhibitors
